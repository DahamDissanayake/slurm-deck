[Unit]
Description=Announce the Slurm Deck session name over mDNS
After=avahi-daemon.service network-online.target
Requires=avahi-daemon.service

[Service]
# SESSION_HOSTNAME and LAN_ADDR are written by the installer. Notebooks,
# TensorBoard and terminals are served from this name, apart from the app's.
EnvironmentFile=/etc/slurm-deck-web/gpu-helper.env
ExecStart=/usr/bin/avahi-publish -a -R ${SESSION_HOSTNAME} ${LAN_ADDR}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
