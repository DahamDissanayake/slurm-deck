# Secrets: /etc/slurm-deck-web/secrets.env (slurmadmin:sdweb 0640). Copy this
# file and fill it in; never commit the real one.

# Password of the database owner (the db container creates the sdweb user with it).
POSTGRES_PASSWORD=
# The app database, with the same password: postgresql://sdweb:<password>@db:5432/slurmdeck
SD_DATABASE_URL=
# Password for the read-only role deck-agent uses; set when `migrate` runs.
# deck-agent's SD_DB_RO_URL uses it: postgresql://sd_agent_ro:<password>@127.0.0.1:5432/slurmdeck
SD_AGENT_DB_PASSWORD=

# Mail provider credentials (only the one SD_MAIL_PROVIDER names is needed).
SD_RESEND_API_KEY=
SD_SMTP_PASSWORD=
