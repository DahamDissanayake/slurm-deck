# deck-agent settings. Written by the installer (root 0600).
SD_WEB_UID=${web_uid}
SD_WORKER_UID=${worker_uid}
SD_DB_RO_URL=postgresql://sd_agent_ro:${agent_db_password}@127.0.0.1:5432/slurmdeck
SD_NFS_ROOT=${nfs_root}
SD_PARTITION=${partition}
SD_COMPUTE_NODE=${compute_node}
SD_SLURM_ACCOUNT=${slurm_account}
SD_SLURM_QOS=${slurm_qos}
SD_GPU_HELPER_SSH=sdprov@${gpu_host}
SD_GPU_HELPER_KEY=/etc/slurm-deck-web/sdprov_ed25519
SD_GRANT_KEY_FILE=/etc/slurm-deck-web/grant.key
