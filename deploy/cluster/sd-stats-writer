#!/usr/bin/env python3
"""Write live GPU/CPU/RAM stats to $NFS_ROOT/.gpu_stats.json every 2 seconds.

Runs on the GPU host as the sd-stats system account (sd-stats-writer.service).
sd-stats can't create files in the share root, so the installer pre-creates the
stats file owned by sd-stats and this rewrites it in place with one write();
readers treat a short or unreadable file as "no live stats".
"""

import json
import os
import subprocess
import time
from pathlib import Path

INTERVAL = 2


def collect() -> dict:
    stats: dict = {}
    try:
        r = subprocess.run(
            ["nvidia-smi",
             "--query-gpu=utilization.gpu,utilization.memory,"
             "memory.used,memory.total,temperature.gpu,power.draw",
             "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=5,
        )
        if r.returncode == 0:
            parts = [p.strip() for p in r.stdout.strip().splitlines()[0].split(",")]
            stats["gpu_util"] = int(parts[0])
            stats["gpu_mem_util"] = int(parts[1])
            stats["gpu_mem_used_mb"] = int(parts[2])
            stats["gpu_mem_total_mb"] = int(parts[3])
            stats["gpu_temp"] = int(parts[4])
            try:
                stats["gpu_power_w"] = float(parts[5])
            except (ValueError, IndexError):
                stats["gpu_power_w"] = 0.0
    except (OSError, subprocess.SubprocessError, ValueError, IndexError):
        pass

    try:
        vals = Path("/proc/loadavg").read_text().split()
        ncpu = os.cpu_count() or 1
        stats["cpu_load1"] = float(vals[0])
        stats["cpu_load5"] = float(vals[1])
        stats["cpu_util"] = min(int(float(vals[0]) / ncpu * 100), 100)
    except (OSError, ValueError, IndexError):
        pass

    try:
        mem: dict[str, int] = {}
        for line in Path("/proc/meminfo").read_text().splitlines():
            k, v = line.split(":", 1)
            mem[k.strip()] = int(v.strip().split()[0])
        total_mb = mem.get("MemTotal", 0) // 1024
        stats["mem_total_mb"] = total_mb
        stats["mem_used_mb"] = total_mb - mem.get("MemAvailable", 0) // 1024
    except (OSError, ValueError, IndexError):
        pass

    stats["ts"] = time.time()
    return stats


def write_stats(path: Path, data: dict) -> None:
    payload = json.dumps(data).encode()
    fd = os.open(path, os.O_WRONLY | os.O_TRUNC | os.O_CREAT, 0o644)
    try:
        os.write(fd, payload)
    finally:
        os.close(fd)


def main() -> None:
    path = Path(os.environ.get("NFS_ROOT", "/shared")) / ".gpu_stats.json"
    while True:
        try:
            write_stats(path, collect())
        except OSError:
            pass
        time.sleep(INTERVAL)


if __name__ == "__main__":
    main()
