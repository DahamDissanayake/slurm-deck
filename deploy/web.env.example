# Web settings: /etc/slurm-deck-web/web.env (slurmadmin:sdweb 0640). Values
# marked secrets.env go in /etc/slurm-deck-web/secrets.env instead.

# App database (secrets.env): postgresql://sdweb:<password>@db:5432/slurmdeck
# SD_DATABASE_URL=
# Password for the read-only role deck-agent uses (secrets.env); set at migrate time.
# SD_AGENT_DB_PASSWORD=

SD_AGENT_SOCKET=/run/slurm-deck-web/agent.sock
SD_PUBLIC_HOSTNAME=slurmdeck.local
SD_CLUSTER_NAME=Slurm Deck
# IANA timezone used to show times, e.g. Asia/Colombo
SD_CLUSTER_TZ=UTC

# Mail: resend, smtp or none
SD_MAIL_PROVIDER=none
SD_MAIL_FROM=
# SD_RESEND_API_KEY=            (secrets.env)
SD_SMTP_HOST=
SD_SMTP_PORT=587
SD_SMTP_USER=
# SD_SMTP_PASSWORD=             (secrets.env)
SD_SMTP_STARTTLS=true

# Only turn off for local testing over plain http.
SD_SECURE_COOKIES=true

# UID range for new web accounts (read when the database is first migrated).
SD_WEB_UID_MIN=20000
SD_WEB_UID_MAX=59999

# The spec's fixed values (SESSION_IDLE_MINUTES, LOCKOUT_FAILS, ...) can be
# overridden here too; see src/sdweb/config.py for the names and defaults.
