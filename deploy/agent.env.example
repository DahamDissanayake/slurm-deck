# deck-agent settings: /etc/slurm-deck-web/agent.env (root 0600). Copy this
# file and fill in your site; defaults are shown commented out.

# UIDs of the web and worker service accounts (the only peers allowed in).
SD_WEB_UID=
SD_WORKER_UID=
# Read-only DSN for the agent_sessions/agent_accounts views (role sd_agent_ro).
SD_DB_RO_URL=

# SD_AGENT_SOCKET=/run/slurm-deck-web/agent.sock
# SD_NFS_ROOT=/shared
# SD_STATS_FILE=/shared/.gpu_stats.json
# SD_AUDIT_LOG=/var/log/slurm-deck-web/agent-audit.jsonl

# Slurm: binaries, the partition and compute node shown on the dashboard, and
# the account and QOS new users are added to.
# SD_SLURM_BIN=/usr/bin
# SD_PARTITION=gpu
SD_COMPUTE_NODE=
# SD_SLURM_ACCOUNT=default
# SD_SLURM_QOS=normal

# Groups and the ops account.
# SD_WEBUSERS_GROUP=webusers
# SD_GPUUSERS_GROUP=gpuusers
# SD_ADMIN_GROUP=gpuadmins
# SD_OPS_USER=sd-ops

# GPU-host helper over SSH (forced command), e.g. sdprov@gpu-host.
SD_GPU_HELPER_SSH=
SD_GPU_HELPER_KEY=/etc/slurm-deck-web/sdprov_ed25519

# UID range for new web accounts.
# SD_WEB_UID_MIN=20000
# SD_WEB_UID_MAX=59999

# Ports interactive sessions (notebook, terminal, TensorBoard) may use on the
# GPU node; session.info refuses a session line outside this range.
# SESSION_PORT_RANGE=8800-8999

# The pod-resize script deck-agent runs as slurmadmin (admin pods resize).
# SD_RESIZE_SCRIPT=/opt/slurm-deck-web/deploy/cluster/resize-pods.sh
# Limits.
# SD_MAX_WORKERS=8
# SD_REQUEST_DEADLINE_S=30
# SD_MAX_JSON_BYTES=1048576
